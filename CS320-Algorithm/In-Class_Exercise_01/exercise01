from sys import argv
import time

words = [
    "Liftoff!",
    "One",
    "Two",
    "Three",
    "Four",
    "Five",
    "Six",
    "Seven",
    "Eight",
    "Nine",
    "Ten",
]


def countdown(n):
    for i_count in range(n, -1, -1):
        if i_count < len(words):
            print(f"{words[i_count]}", end="")
            if i_count:
                print("...")
            else:
                print("")

        if i_count > 0:
            time.sleep(1)

countdown(int(argv[1]))

