from sys import argv
import time

words = [
    "Liftoff!",
    "One",
    "Two",
    "Three",
    "Four",
    "Five",
    "Six",
    "Seven",
    "Eight",
    "Nine",
    "Ten",
]


def countdown(n):
    for i in range(n, -1, -1):
        if i < len(words):
            print(f"{words[i]}", end="")
            if i:
                print("...")
            else:
                print("")

        if i > 0:
            time.sleep(1)

countdown(20)

